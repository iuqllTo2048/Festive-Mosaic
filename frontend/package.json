{
  "name": "verifyatlas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json -o src/api/schema.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": { "vue": "3.5.45" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
